# Copia este archivo como .env y coloca tus valores reales.
# El archivo .env NUNCA se sube a Git (está en .gitignore).

# API key de https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo a usar. "openrouter/free" elige automáticamente un modelo gratuito.
OPENROUTER_MODEL=openrouter/free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

APP_ENV=development
